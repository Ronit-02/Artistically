// ─────────────────────────────────────────────────────────────────────────────
// Artistically — Prisma Schema
// Database: PostgreSQL (recommended: Neon serverless https://neon.tech)
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  USER
  ARTIST
  ADMIN
}

enum OrderStatus {
  PROCESSING
  CONFIRMED
  SHIPPED
  IN_TRANSIT
  DELIVERED
  CANCELLED
  REFUNDED
}

enum ProductCategory {
  PAINTINGS
  SCULPTURES
  CERAMICS
  DIGITAL_ART
  GLASS_ART
  WOODWORK
  PHOTOGRAPHY
  TEXTILE
}

enum ArtworkType {
  ORIGINAL
  LIMITED_EDITION
  MADE_TO_ORDER
  DIGITAL
}

enum FulfillmentMode {
  PHYSICAL
  DIGITAL
}

enum FulfillmentStatus {
  PENDING
  PROCESSING
  SHIPPED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum ReportReason {
  INACCURATE
  COPYRIGHT
  PROHIBITED
  HARASSMENT
  OTHER
}

enum ModerationStatus {
  OPEN
  DISMISSED
  RESOLVED
}

enum AppealStatus {
  OPEN
  APPROVED
  REJECTED
}

enum ModerationEventType {
  REPORT_CREATED
  REPORT_DISMISSED
  REPORT_RESOLVED
  APPEAL_SUBMITTED
  APPEAL_APPROVED
  APPEAL_REJECTED
}

enum ArtistVerificationStatus {
  NOT_SUBMITTED
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  REVOKED
}

enum VerificationEvidenceType {
  IDENTITY
  BACKGROUND
  PORTFOLIO
}

enum CheckoutSessionStatus {
  PENDING
  COMPLETED
  EXPIRED
  FAILED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentReconciliationStatus {
  RECONCILED
  OUT_OF_BALANCE
}

enum SellerOrderStatus {
  PROCESSING
  SHIPPED
  IN_TRANSIT
  DELIVERED
  CANCELLED
  REFUNDED
}

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  IN_TRANSIT
  DELIVERED
  EXCEPTION
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PayoutStatus {
  PENDING
  IN_TRANSIT
  PAID
  FAILED
}

enum TransferStatus {
  PENDING
  CREATED
  FAILED
  REVERSED
}

enum SettlementStatus {
  PENDING
  TRANSFERRED
  REFUNDED
  OUT_OF_BALANCE
}

enum ConnectAccountStatus {
  PENDING
  ONBOARDING
  ACTIVE
  RESTRICTED
  DISABLED
}

enum DigitalDeliveryStatus {
  PENDING
  AVAILABLE
  DOWNLOADED
  EXPIRED
  REVOKED
}

enum DeliveryRecordType {
  ORDER_CONFIRMED
  PROCESSING_STARTED
  SHIPPED
  DELIVERED
  DIGITAL_AVAILABLE
  DIGITAL_DOWNLOADED
  CANCELLED
  REFUNDED
  DISPUTE_OPENED
  DISPUTE_RESOLVED
}

enum DisputeType {
  DAMAGE
  NON_DELIVERY
  AUTHENTICITY
  COPYRIGHT
  DIGITAL_ACCESS
  OTHER
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum MediaPurpose {
  ARTWORK_IMAGE
  DIGITAL_FILE
  ARTIST_COVER
  VERIFICATION_EVIDENCE
}

enum MediaStatus {
  UPLOADING
  READY
  FAILED
  DELETED
}

enum MediaVisibility {
  PUBLIC
  PRIVATE
}

enum ListingSubmissionStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum NotificationKind {
  PAYMENT
  FULFILLMENT
  DELIVERY
  CANCELLATION
  REFUND
  PAYOUT
}

enum EmailDeliveryStatus {
  QUEUED
  SENT
  FAILED
}

enum ReviewModerationStatus {
  PUBLISHED
  HIDDEN
  REMOVED
}

enum CertificateStatus {
  PENDING
  VERIFIED
  REVOKED
}

// ─── User ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String // bcrypt hashed
  firstName String
  lastName  String
  phone     String?
  address   String?
  avatar    String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  artist              Artist?
  orders              Order[]
  checkoutSessions    CheckoutSession[]
  reviews             Review[]
  wishlist            WishlistItem[]
  cart                CartItem[]
  follows             Follow[]
  submittedReports    Report[]             @relation("Reporters")
  reviewedReports     Report[]             @relation("ReportReviewers")
  appeals             ModerationAppeal[]   @relation("AppealAppellants")
  reviewedAppeals     ModerationAppeal[]   @relation("AppealReviewers")
  moderationEvents    ModerationEvent[]
  verificationReviews ArtistVerification[] @relation("VerificationReviewers")
  disputes            Dispute[]             @relation("DisputeClaimants")
  reviewedDisputes    Dispute[]             @relation("DisputeReviewers")
  moderatedReviews    Review[]              @relation("ReviewModerators")
  auditLogs           AuditLog[]
  deliveryRecords     DeliveryRecord[]      @relation("DeliveryRecordActors")
  notifications       Notification[]
  emailDeliveries     EmailDelivery[]

  @@map("users")
}

// ─── Artist ──────────────────────────────────────────────────────────────────

model Artist {
  id        String   @id @default(cuid())
  userId    String   @unique
  handle    String   @unique
  bio       String?
  cover     String?
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  products      Product[]
  followers     Follow[]            @relation("ArtistFollowers")
  collections   Collection[]
  verification  ArtistVerification?
  sellerOrders  SellerOrder[]
  payouts       Payout[]
  stripeAccount StripeAccount?
  settlements   SellerSettlement[]
  transfers     StripeTransfer[]
  mediaAssets   MediaAsset[]
  listingSubmissions ListingSubmission[]
  certificates   CertificateOfAuthenticity[]

  @@map("artists")
}

model ArtistVerification {
  id           String                   @id @default(cuid())
  artistId     String                   @unique
  reviewerId   String?
  status       ArtistVerificationStatus @default(NOT_SUBMITTED)
  submittedAt  DateTime?
  reviewedAt   DateTime?
  decisionNote String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  artist   Artist                       @relation(fields: [artistId], references: [id], onDelete: Cascade)
  reviewer User?                        @relation("VerificationReviewers", fields: [reviewerId], references: [id], onDelete: SetNull)
  evidence ArtistVerificationEvidence[]

  @@index([status, submittedAt])
  @@index([reviewerId, reviewedAt])
  @@map("artist_verifications")
}

model ArtistVerificationEvidence {
  id             String                   @id @default(cuid())
  verificationId String
  type           VerificationEvidenceType
  reference      String
  note           String?
  providerPolicyId String?
  retainedUntil  DateTime?
  deletedAt      DateTime?
  createdAt      DateTime                 @default(now())

  verification ArtistVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  providerPolicy EvidenceProviderPolicy? @relation(fields: [providerPolicyId], references: [id], onDelete: SetNull)

  @@index([verificationId, type])
  @@map("artist_verification_evidence")
}

// ─── Follow ──────────────────────────────────────────────────────────────────

model Follow {
  id        String   @id @default(cuid())
  artistId  String
  userId    String
  createdAt DateTime @default(now())

  artist Artist @relation("ArtistFollowers", fields: [artistId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([artistId, userId])
  @@index([userId])
  @@map("follows")
}

// ─── Product ─────────────────────────────────────────────────────────────────

model Product {
  id            String          @id @default(cuid())
  artistId      String
  title         String
  description   String?
  // INR paise; never store authoritative money as floating point.
  price         Int
  originalPrice Int?
  discount      Int?
  category      ProductCategory
  badge         String?
  stock         Int             @default(1)
  isActive      Boolean         @default(true)
  processingDays Int?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  artist          Artist           @relation(fields: [artistId], references: [id], onDelete: Cascade)
  images          ProductImage[]
  reviews         Review[]
  orderItems      OrderItem[]
  cartItems       CartItem[]
  wishlistItems   WishlistItem[]
  artworkDetails  ArtworkDetails?
  collectionItems CollectionItem[]
  reports         Report[]
  mediaAssets     MediaAsset[]
  submission      ListingSubmission?
  certificate     CertificateOfAuthenticity?

  @@index([artistId])
  @@index([category, isActive])
  @@index([isActive, createdAt])
  @@map("products")
}

// ─── Artwork details ────────────────────────────────────────────────────────

model ArtworkDetails {
  id              String          @id @default(cuid())
  productId       String          @unique
  artworkType     ArtworkType     @default(ORIGINAL)
  medium          String?
  materials       String?
  width           Float?
  height          Float?
  depth           Float?
  dimensionUnit   String          @default("cm")
  year            Int?
  condition       String?
  framing         String?
  editionSize     Int?
  editionNumber   Int?
  authenticity    String?
  provenance      String?
  fulfillmentMode FulfillmentMode @default(PHYSICAL)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("artwork_details")
}

// ─── Product Image ────────────────────────────────────────────────────────────

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)
  mediaAssetId String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
  @@index([mediaAssetId])
  @@map("product_images")
}

// ─── Review ──────────────────────────────────────────────────────────────────

model Review {
  id          String   @id @default(cuid())
  productId   String
  userId      String
  orderItemId String?
  rating      Float
  text        String
  moderationStatus ReviewModerationStatus @default(PUBLISHED)
  moderationNote String?
  moderatedById String?
  moderatedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  moderatedBy User? @relation("ReviewModerators", fields: [moderatedById], references: [id], onDelete: SetNull)

  @@unique([productId, userId])
  @@unique([orderItemId])
  @@index([productId, createdAt])
  @@index([userId])
  @@index([moderationStatus, createdAt])
  @@map("reviews")
}

// ─── Order ───────────────────────────────────────────────────────────────────

model Order {
  id                String      @id @default(cuid())
  userId            String
  status            OrderStatus @default(PROCESSING)
  // All amounts are INR paise.
  subtotal          Int
  shippingCost      Int       @default(20000)
  tax               Int
  discount          Int       @default(0)
  total             Int
  shippingAddress   String
  promoCode         String?
  estimatedDelivery DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        OrderItem[]
  payment      Payment?
  reconciliation PaymentReconciliation?
  sellerOrders SellerOrder[]
  refunds      Refund[]
  platformFees PlatformFee[]
  disputes     Dispute[]
  deliveryRecords DeliveryRecord[]

  @@index([userId, createdAt])
  @@map("orders")
}

model CheckoutSession {
  id              String                @id @default(cuid())
  userId          String
  idempotencyKey  String
  stripeSessionId String?               @unique
  status          CheckoutSessionStatus @default(PENDING)
  currency        String                @default("inr")
  amount          Int
  quoteSnapshot   Json
  shippingAddress String
  promoCode       String?
  expiresAt       DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment Payment?

  @@unique([userId, idempotencyKey])
  @@index([userId, status, createdAt])
  @@map("checkout_sessions")
}

model Payment {
  id                String        @id @default(cuid())
  checkoutSessionId String        @unique
  orderId           String?       @unique
  stripePaymentId   String?       @unique
  status            PaymentStatus @default(PENDING)
  amount            Int
  currency          String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  checkoutSession CheckoutSession @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade)
  order           Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  events          PaymentEvent[]
  refunds         Refund[]
  reconciliation PaymentReconciliation?

  @@index([status, createdAt])
  @@map("payments")
}

model PaymentEvent {
  id            String    @id @default(cuid())
  paymentId     String?
  stripeEventId String    @unique
  type          String
  payload       Json
  processedAt   DateTime?
  createdAt     DateTime  @default(now())

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([paymentId, createdAt])
  @@map("payment_events")
}

model PaymentReconciliation {
  id                  String                       @id @default(cuid())
  paymentId           String                       @unique
  orderId             String                       @unique
  currency            String
  capturedAmount      Int
  sellerAllocatedAmount Int
  taxAmount           Int
  discountAmount      Int
  platformFeeAmount   Int
  refundedAmount      Int                        @default(0)
  status              PaymentReconciliationStatus @default(RECONCILED)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
  @@map("payment_reconciliations")
}

model SellerOrder {
  id           String            @id @default(cuid())
  orderId      String
  artistId     String
  status       SellerOrderStatus @default(PROCESSING)
  subtotal     Int
  shippingCost Int             @default(0)
  total        Int
  processingDueAt DateTime?
  acceptedAt DateTime?
  lateAt DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  artist       Artist        @relation(fields: [artistId], references: [id], onDelete: Restrict)
  items        OrderItem[]
  shipment     Shipment?
  refunds      Refund[]
  platformFees PlatformFee[]
  payouts      Payout[]
  settlement   SellerSettlement?
  transfers    StripeTransfer[]
  disputes     Dispute[]
  deliveryRecords DeliveryRecord[]

  @@unique([orderId, artistId])
  @@index([artistId, status, createdAt])
  @@map("seller_orders")
}

model Shipment {
  id             String         @id @default(cuid())
  sellerOrderId  String         @unique
  status         ShipmentStatus @default(PENDING)
  carrier        String?
  trackingNumber String?
  trackingUrl    String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  sellerOrder SellerOrder     @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  events      ShipmentEvent[]

  @@index([status, updatedAt])
  @@map("shipments")
}

model ShipmentEvent {
  id              String         @id @default(cuid())
  shipmentId      String
  providerEventId String?        @unique
  status          ShipmentStatus
  occurredAt      DateTime
  location        String?
  note            String?
  payload         Json?
  createdAt       DateTime       @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
  @@map("shipment_events")
}

model Refund {
  id             String       @id @default(cuid())
  orderId        String
  paymentId      String?
  sellerOrderId  String?
  stripeRefundId String?      @unique
  idempotencyKey String       @unique
  status         RefundStatus @default(PENDING)
  amount         Int
  currency       String
  reason         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment     Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  sellerOrder SellerOrder? @relation(fields: [sellerOrderId], references: [id], onDelete: SetNull)

  @@index([orderId, status, createdAt])
  @@index([paymentId, createdAt])
  @@map("refunds")
}

model PlatformFee {
  id            String   @id @default(cuid())
  orderId       String
  sellerOrderId String?
  amount        Int
  currency      String
  description   String
  createdAt     DateTime @default(now())

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerOrder SellerOrder? @relation(fields: [sellerOrderId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("platform_fees")
}

model Payout {
  id             String       @id @default(cuid())
  artistId       String
  sellerOrderId  String?
  stripePayoutId String?      @unique
  status         PayoutStatus @default(PENDING)
  amount         Int
  currency       String
  availableAt    DateTime?
  paidAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  artist      Artist       @relation(fields: [artistId], references: [id], onDelete: Restrict)
  sellerOrder SellerOrder? @relation(fields: [sellerOrderId], references: [id], onDelete: SetNull)

  @@index([artistId, status, createdAt])
  @@index([sellerOrderId, createdAt])
  @@map("payouts")
}

model SellerSettlement {
  id                  String           @id @default(cuid())
  artistId            String
  sellerOrderId       String           @unique
  currency            String
  grossAmount         Int
  shippingAmount      Int
  platformFeeAmount   Int
  refundAmount        Int              @default(0)
  netAmount           Int
  transferredAmount   Int              @default(0)
  status              SettlementStatus @default(PENDING)
  reconciledAt        DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  artist      Artist      @relation(fields: [artistId], references: [id], onDelete: Restrict)
  sellerOrder SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  transfer    StripeTransfer?

  @@index([artistId, status, createdAt])
  @@map("seller_settlements")
}

model StripeTransfer {
  id                      String         @id @default(cuid())
  artistId                String
  sellerOrderId           String
  settlementId            String         @unique
  stripeTransferId        String?        @unique
  stripeBalanceTransactionId String?
  destinationAccountId    String
  status                  TransferStatus @default(PENDING)
  amount                  Int
  currency                String
  reversedAmount          Int            @default(0)
  idempotencyKey          String         @unique
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  artist      Artist          @relation(fields: [artistId], references: [id], onDelete: Restrict)
  sellerOrder SellerOrder     @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  settlement  SellerSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([artistId, status, createdAt])
  @@index([sellerOrderId, createdAt])
  @@map("stripe_transfers")
}

model StripeAccount {
  id               String               @id @default(cuid())
  artistId         String               @unique
  stripeAccountId  String               @unique
  status           ConnectAccountStatus @default(PENDING)
  detailsSubmitted Boolean              @default(false)
  chargesEnabled   Boolean              @default(false)
  payoutsEnabled   Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([status, payoutsEnabled])
  @@map("stripe_accounts")
}

// ─── Order Item ──────────────────────────────────────────────────────────────

model OrderItem {
  id                String            @id @default(cuid())
  orderId           String
  productId         String
  quantity          Int
  size              String
  // Snapshot price in INR paise.
  price             Int
  fulfillmentStatus FulfillmentStatus @default(PENDING)
  sellerOrderId     String?

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id])
  review      Review?
  sellerOrder SellerOrder? @relation(fields: [sellerOrderId], references: [id], onDelete: SetNull)
  digitalDelivery DigitalDelivery?
  deliveryRecords DeliveryRecord[]
  disputes Dispute[]

  @@index([orderId])
  @@index([productId])
  @@index([sellerOrderId])
  @@map("order_items")
}

model DigitalDelivery {
  id                   String                @id @default(cuid())
  orderItemId          String                @unique
  assetReference       String
  status               DigitalDeliveryStatus @default(PENDING)
  downloadLimit        Int                   @default(3)
  downloadCount        Int                   @default(0)
  expiresAt            DateTime?
  availableAt          DateTime?
  deliveredAt          DateTime?
  lastDownloadedAt     DateTime?
  licenseAcceptedAt    DateTime?
  mediaAssetId         String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@map("digital_deliveries")
}

model MediaAsset {
  id           String          @id @default(cuid())
  artistId     String
  productId    String?
  purpose      MediaPurpose
  status       MediaStatus     @default(UPLOADING)
  visibility   MediaVisibility @default(PRIVATE)
  provider     String
  providerKey  String          @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  checksum     String?
  width        Int?
  height       Int?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  retainedUntil DateTime?
  deletedAt     DateTime?

  artist            Artist             @relation(fields: [artistId], references: [id], onDelete: Cascade)
  product           Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  productImages     ProductImage[]
  digitalDeliveries DigitalDelivery[]
  certificates      CertificateOfAuthenticity[]

  @@index([artistId, purpose, status])
  @@index([productId, purpose])
  @@map("media_assets")
}

model ListingSubmission {
  id          String                  @id @default(cuid())
  productId   String                  @unique
  artistId    String
  status      ListingSubmissionStatus @default(SUBMITTED)
  submittedAt DateTime                @default(now())
  reviewedAt  DateTime?
  reviewNote  String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  artist  Artist  @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId, status, submittedAt])
  @@map("listing_submissions")
}

model DeliveryRecord {
  id            String             @id @default(cuid())
  orderId       String
  sellerOrderId String?
  orderItemId   String?
  actorId       String?
  type          DeliveryRecordType
  occurredAt    DateTime           @default(now())
  note          String?
  metadata      Json?
  createdAt     DateTime           @default(now())

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerOrder SellerOrder? @relation(fields: [sellerOrderId], references: [id], onDelete: SetNull)
  orderItem   OrderItem?   @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  actor       User?        @relation("DeliveryRecordActors", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, occurredAt])
  @@index([sellerOrderId, occurredAt])
  @@index([orderItemId, occurredAt])
  @@map("delivery_records")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  kind      NotificationKind
  title     String
  body      String
  href      String?
  dedupeKey String           @unique
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailDeliveries EmailDelivery[]

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model EmailDelivery {
  id             String              @id @default(cuid())
  userId         String
  notificationId String?
  eventKey       String              @unique
  toEmail        String
  subject        String
  body           String
  status         EmailDeliveryStatus @default(QUEUED)
  sentAt         DateTime?
  failedAt       DateTime?
  error          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt])
  @@map("email_deliveries")
}

model Dispute {
  id             String        @id @default(cuid())
  orderId        String
  claimantId     String
  sellerOrderId  String?
  orderItemId    String?
  type           DisputeType
  status         DisputeStatus @default(OPEN)
  reason         String
  resolutionNote String?
  reviewerId     String?
  resolvedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  claimant    User         @relation("DisputeClaimants", fields: [claimantId], references: [id], onDelete: Cascade)
  reviewer    User?        @relation("DisputeReviewers", fields: [reviewerId], references: [id], onDelete: SetNull)
  sellerOrder SellerOrder? @relation(fields: [sellerOrderId], references: [id], onDelete: SetNull)
  orderItem   OrderItem?   @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([orderId, status, createdAt])
  @@index([claimantId, createdAt])
  @@index([status, createdAt])
  @@map("disputes")
}

// ─── Cart Item ───────────────────────────────────────────────────────────────

model CartItem {
  id        String @id @default(cuid())
  userId    String
  productId String
  quantity  Int    @default(1)
  size      String @default("5x7")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, size])
  @@map("cart_items")
}

// ─── Wishlist Item ───────────────────────────────────────────────────────────

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

// ─── Story ───────────────────────────────────────────────────────────────────

model Story {
  id        String   @id @default(cuid())
  title     String
  excerpt   String?
  content   String
  image     String
  category  String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("stories")
}

// ─── Collection ─────────────────────────────────────────────────────────────

model Collection {
  id            String   @id @default(cuid())
  name          String
  description   String
  coverImage    String
  featured      Boolean  @default(false)
  published     Boolean  @default(false)
  ownerArtistId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ownerArtist Artist?          @relation(fields: [ownerArtistId], references: [id], onDelete: SetNull)
  items       CollectionItem[]
  reports     Report[]

  @@index([published, featured, createdAt])
  @@index([ownerArtistId])
  @@map("collections")
}

model CollectionItem {
  id           String @id @default(cuid())
  collectionId String
  productId    String
  sortOrder    Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
  @@index([collectionId, sortOrder])
  @@index([productId])
  @@map("collection_items")
}

// ─── Moderation reports ─────────────────────────────────────────────────────

model Report {
  id             String           @id @default(cuid())
  reporterId     String
  reviewerId     String?
  productId      String?
  collectionId   String?
  reason         ReportReason
  details        String?
  status         ModerationStatus @default(OPEN)
  resolutionNote String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  reporter   User              @relation("Reporters", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewer   User?             @relation("ReportReviewers", fields: [reviewerId], references: [id], onDelete: SetNull)
  product    Product?          @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection?       @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  appeal     ModerationAppeal?
  events     ModerationEvent[]

  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  @@index([productId, status])
  @@index([collectionId, status])
  @@map("reports")
}

model ModerationAppeal {
  id           String       @id @default(cuid())
  reportId     String       @unique
  appellantId  String
  reviewerId   String?
  statement    String
  status       AppealStatus @default(OPEN)
  decisionNote String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  report    Report            @relation(fields: [reportId], references: [id], onDelete: Cascade)
  appellant User              @relation("AppealAppellants", fields: [appellantId], references: [id], onDelete: Cascade)
  reviewer  User?             @relation("AppealReviewers", fields: [reviewerId], references: [id], onDelete: SetNull)
  events    ModerationEvent[]

  @@index([status, createdAt])
  @@index([appellantId, createdAt])
  @@map("moderation_appeals")
}

model ModerationEvent {
  id        String              @id @default(cuid())
  reportId  String
  appealId  String?
  actorId   String
  type      ModerationEventType
  note      String?
  createdAt DateTime            @default(now())

  report Report            @relation(fields: [reportId], references: [id], onDelete: Cascade)
  appeal ModerationAppeal? @relation(fields: [appealId], references: [id], onDelete: Cascade)
  actor  User              @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([reportId, createdAt])
  @@index([appealId, createdAt])
  @@map("moderation_events")
}

model EvidenceProviderPolicy {
  id            String   @id @default(cuid())
  providerKey   String   @unique
  name          String
  retentionDays Int
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  evidence ArtistVerificationEvidence[]

  @@map("evidence_provider_policies")
}

model CertificateOfAuthenticity {
  id                String            @id @default(cuid())
  productId         String            @unique
  artistId          String
  mediaAssetId      String?
  certificateNumber String            @unique
  status            CertificateStatus @default(PENDING)
  note              String?
  issuedAt          DateTime          @default(now())
  verifiedAt        DateTime?
  revokedAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([artistId, status, createdAt])
  @@map("certificates_of_authenticity")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}
