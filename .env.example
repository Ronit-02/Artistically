# App
NODE_ENV = "development"
NEXT_PUBLIC_APP_URL = "http://127.0.0.1:3001"

# Database (PostgreSQL)
## Docker Postgres container (local)
# DATABASE_URL="postgresql://artistically:artistically_dev_password@localhost:5432/artistically?schema=public"
## Neon Postgres (cloud)
DATABASE_URL = ""
RUN_DATABASE_TESTS = "true"

# Auth
JWT_SECRET = "replace-with-at-least-32-random-characters"

# Gmail OAuth Credentials
GOOGLE_CLIENT_ID = "replace-with-google-client-id"
GOOGLE_CLIENT_SECRET = "replace-with-google-client-secret"

# Platform performance
PLATFORM_FEE_BASIS_POINTS = "1000"

# Shipment provider callback signing.
SHIPMENT_WEBHOOK_SECRET = "replace-with-at-least-16-random-characters"

# Media storage. Local storage is suitable only for development on one machine.
MEDIA_STORAGE_PROVIDER = "local"
MEDIA_LOCAL_DIR = ".media"

# For S3-compatible production storage
# MEDIA_STORAGE_PROVIDER = "s3"
# MEDIA_STORAGE_BUCKET="artistically-media"
# MEDIA_STORAGE_REGION="ap-south-1"
# MEDIA_STORAGE_ENDPOINT="https://s3.ap-south-1.amazonaws.com"
# MEDIA_STORAGE_ACCESS_KEY_ID="replace-me"
# MEDIA_STORAGE_SECRET_ACCESS_KEY="replace-me"
# MEDIA_STORAGE_PUBLIC_BASE_URL="https://media.example.com"

# Optional external integrations.
# EMAIL_WEBHOOK_URL="https://email-provider.example.com/send"
# DIGITAL_ASSET_BASE_URL="https://downloads.example.com/assets/"
# FULFILLMENT_CRON_SECRET="replace-with-at-least-32-random-characters"

# Stripe
# STRIPE_SECRET_KEY = "sk_test_replace_me"
# STRIPE_WEBHOOK_SECRET = "whsec_replace_me"

# Optional override used only by npm run seed:dev
SEED_ADMIN_PASSWORD = "Artistically@123"
SEED_ARTIST_PASSWORD = "Artistically@123"
SEED_COLLECTOR_PASSWORD = "Artistically@123"