# Artistically environment variables
# Copy this file to .env.local for local development.
# Keep .env.local and every real credential out of source control.

# Core local settings mirrored from .env.local with safe sample values.
DATABASE_URL="postgresql://artistically:change-me@localhost:5432/artistically?schema=public"
JWT_SECRET="replace-with-at-least-32-random-characters"
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NODE_ENV="development"

# Stripe checkout and Stripe Connect. Required for live payment flows.
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"

# Platform fee in basis points. 1000 equals 10 percent.
PLATFORM_FEE_BASIS_POINTS="1000"

# Shipment provider callback signing.
SHIPMENT_WEBHOOK_SECRET="replace-with-at-least-16-random-characters"

# Media storage. Local storage is suitable only for development on one machine.
MEDIA_STORAGE_PROVIDER="local"
MEDIA_LOCAL_DIR=".media"

# For S3-compatible production storage, set MEDIA_STORAGE_PROVIDER="s3"
# and configure the values below.
# MEDIA_STORAGE_BUCKET="artistically-media"
# MEDIA_STORAGE_REGION="ap-south-1"
# MEDIA_STORAGE_ENDPOINT="https://s3.ap-south-1.amazonaws.com"
# MEDIA_STORAGE_ACCESS_KEY_ID="replace-me"
# MEDIA_STORAGE_SECRET_ACCESS_KEY="replace-me"
# MEDIA_STORAGE_PUBLIC_BASE_URL="https://media.example.com"

# Optional external integrations.
# EMAIL_WEBHOOK_URL="https://email-provider.example.com/send"
# DIGITAL_ASSET_BASE_URL="https://downloads.example.com/assets/"
# FULFILLMENT_CRON_SECRET="replace-with-at-least-32-random-characters"

# Optional isolated PostgreSQL integration tests.
# Use a disposable database. The test suite creates and removes fixture rows.
# TEST_DATABASE_URL="postgresql://artistically:change-me@localhost:5432/artistically_test?schema=public"
# RUN_DATABASE_TESTS="true"

# Optional development seed passwords. Defaults exist for local seed data only.
# SEED_ADMIN_PASSWORD="replace-me"
# SEED_ARTIST_PASSWORD="replace-me"
# SEED_COLLECTOR_PASSWORD="replace-me"

# Optional launch smoke-test settings.
# LAUNCH_BASE_URL="http://localhost:3001"
# ALLOW_NOT_READY="false"
# MAX_PUBLIC_HTML_BYTES="200000"
