# ─────────────────────────────────────────────────────────────────────────────
# Artistically — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Neon (recommended): https://neon.tech → create project → copy connection string
# Local:              postgresql://user:password@localhost:5432/artistically
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/artistically?schema=public"

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-change-this"

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── Optional: Image uploads (e.g. Cloudinary) ───────────────────────────────
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# ── Optional: Email (e.g. Resend for order confirmations) ───────────────────
# RESEND_API_KEY=""
# EMAIL_FROM="noreply@artistically.com"
